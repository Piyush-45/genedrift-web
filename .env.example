# Genedrift website — environment
#
# Copy to .env.local for development. Set these in Vercel per environment:
# Preview/UAT points at the Catalyst development host, Production at its own.
# NOTHING here has a default in code — a missing production value fails the
# build rather than silently serving fixtures as real content.

# ---- Catalyst public API (articles) -----------------------------------
# Server-side only, deliberately NOT NEXT_PUBLIC_: all fetching happens in
# server components, so the API host never reaches the browser bundle.
#
# Set the ORIGIN ONLY — the /v1/public prefix lives in lib/content/catalyst.ts,
# so the endpoint version can be changed in one place rather than in every
# environment.
#
# UAT / staging:
#   CATALYST_API_BASE_URL=https://gd-genedrift-publishing-…development.catalystappsail.in
# Production:
#   CATALYST_API_BASE_URL=<production Catalyst URL — pending>
#
# The API is open GET-only today. CATALYST_API_TOKEN is optional and unused;
# it exists so adding auth later is configuration, not a code change.
CATALYST_API_BASE_URL=
CATALYST_API_TOKEN=

# ---- Website pages CMS (a SEPARATE Catalyst project) --------------------
# Website page content comes from the "genedrift-website" Creator app via its
# own Catalyst service. It is NOT the same host as the articles API above —
# two Creator applications, two Catalyst projects, no shared storage, so that
# each can be handed to the client independently.
#
# Unset in development: every page falls back to the built-in content and the
# site renders exactly as it did before the CMS existed.
CATALYST_WEBSITE_API_BASE_URL=

# ---- Creator (contact form submissions) --------------------------------
# Where contact enquiries are posted. Unset means the form tells the visitor
# to email instead — it never reports a false success.
CREATOR_CONTACT_ENDPOINT=
CREATOR_CONTACT_TOKEN=

# ---- On-demand cache refresh --------------------------------------------
# Creator POSTs to /api/revalidate after a successful publish so an edit
# appears at once rather than at the end of the 60-second cache window.
#
# 32+ random characters, and DIFFERENT from the publish signing secret: this
# one is handed to a different caller for a smaller job, and a cache flush is
# far less dangerous than a content write. Blast radius should match the key.
#
# Unset = the endpoint returns 503 and refuses every request. It deliberately
# does NOT fall back to accepting unauthenticated calls — an open cache-flush
# endpoint is a free denial of service against the site's own origin.
REVALIDATE_SECRET=

# ---- Site ---------------------------------------------------------------
# Canonical origin, used for canonical tags, sitemap and social metadata.
NEXT_PUBLIC_SITE_URL=https://genedrift.com

# ---- Deployment ---------------------------------------------------------
# Search engine indexing. DEFAULT IS OFF: only the exact string "true" makes a
# deployment crawlable, so previews and staging domains are private unless
# somebody deliberately opens them.
#
# Leave this UNSET on genedrift.site. Set it to true only on the real
# production domain, and only once the placeholder copy, the unverified
# capability data, the withdrawn ISO standard and the registered address have
# all been replaced with the client's confirmed content.
SITE_INDEXABLE=
